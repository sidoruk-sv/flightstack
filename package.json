{
  "name": "flightstack-monorepo",
  "version": "1.0.0",
  "description": "Real-time Drone Operations Platform",
  "keywords": [
    "flightstack",
    "real-time"
  ],
  "author": "Serhii Sydoruk",
  "license": "ISC",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12",
      "onFail": "download"
    }
  },
  "scripts": {
    "api": "pnpm --filter=api",
    "start": "pnpm --parallel run start",
    "dev": "pnpm --parallel run dev",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "test:integration": "pnpm --recursive --if-present run test:integration",
    "db:up": "podman compose up -d",
    "db:down": "podman compose down",
    "db:reset": "podman compose down -v && podman compose up -d",
    "changelog": "git-conventional-commits changelog -f CHANGELOG.md",
    "prepare": "husky",
    "version:from-commits": "git-conventional-commits version"
  },
  "devDependencies": {
    "git-conventional-commits": "^2.9.0",
    "husky": "^9.1.7"
  }
}
