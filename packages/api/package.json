{
  "name": "api",
  "version": "1.0.0",
  "description": "FlightStack API",
  "keywords": [
    "flightstack",
    "api"
  ],
  "author": "Serhii Sydoruk",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "predev": "pnpm run build",
    "dev": "concurrently --kill-others --names tsc,server \"tsc --watch\" \"FORCE_COLOR=1 node --watch dist/index.js\"",
    "prestart": "pnpm run build",
    "start": "FORCE_COLOR=1 node dist/index.js",
    "clean": "rm -rf dist",
    "test": "tsc && node --test dist/*.test.js",
    "test:integration": "tsc && node --test dist/integration/**/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
